# syntax=docker/dockerfile:1
# Required base: an audited digest-pinned Linux image containing Python 3,
# Node.js and npm. No mutable upstream image is silently selected.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG CLAUDE_CODE_VERSION
RUN test -n "$CLAUDE_CODE_VERSION" \
    && command -v python3 \
    && command -v node \
    && command -v npm \
    && npm install --global "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && claude --version
ENV HOME=/home/maestro \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
RUN mkdir -p /home/maestro /gateway /authority /scratch
COPY src/maestro /opt/maestro/maestro
ENV PYTHONPATH=/opt/maestro
# Runtime identity/privilege drop, readonly mounts, network=none, gateway relay,
# CPU monitor and credentials are provided by the trusted MAESTRO host shim.
WORKDIR /scratch
