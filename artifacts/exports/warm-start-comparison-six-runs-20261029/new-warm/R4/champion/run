#!/usr/bin/env python3
'''Deterministic greedy dominating set with protected reduction seeding.'''
import sys
import heapq
from array import array


def greedy_select(adjacency, n):
    gain = array('i', [0]) * (n + 1)
    heap = []
    max_deg = 0
    for v in range(1, n + 1):
        d = len(adjacency[v])
        if d > max_deg:
            max_deg = d
        g = d + 1
        gain[v] = g
        heap.append((-g, -d, v))
    heapq.heapify(heap)

    dominated = bytearray(n + 1)
    selected = bytearray(n + 1)
    remaining = n
    answer = []

    while remaining:
        neg_g, neg_deg, v = heapq.heappop(heap)
        g = -neg_g
        if selected[v] or g != gain[v]:
            if not selected[v] and gain[v] > 0:
                heapq.heappush(heap, (-gain[v], -len(adjacency[v]), v))
            continue
        if g <= 0:
            continue

        selected[v] = 1
        answer.append(v)

        if not dominated[v]:
            dominated[v] = 1
            remaining -= 1
            gain[v] -= 1
            for w in adjacency[v]:
                gain[w] -= 1

        for u in adjacency[v]:
            if dominated[u]:
                continue
            dominated[u] = 1
            remaining -= 1
            gain[u] -= 1
            for w in adjacency[u]:
                gain[w] -= 1

    return selected, answer, max_deg


def prune_solution(adjacency, n, selected, answer, max_deg):
    coverage = array('i', [0]) * (n + 1)
    for v in answer:
        coverage[v] += 1
        for u in adjacency[v]:
            coverage[u] += 1

    sel_asc = bytearray(selected)
    cov_asc = array('i', coverage)
    count_asc = len(answer)

    for v in sorted(answer):
        if not sel_asc[v] or cov_asc[v] < 2:
            continue
        removable = True
        for u in adjacency[v]:
            if cov_asc[u] < 2:
                removable = False
                break
        if removable:
            sel_asc[v] = 0
            cov_asc[v] -= 1
            for u in adjacency[v]:
                cov_asc[u] -= 1
            count_asc -= 1

    sel_pri = bytearray(selected)
    cov_pri = array('i', coverage)
    count_pri = len(answer)

    max_cov = 0
    for v in range(1, n + 1):
        if cov_pri[v] > max_cov:
            max_cov = cov_pri[v]

    base = max(n, max_deg) + 1
    maxc = max_cov + 1

    def compute_key(v):
        if not sel_pri[v]:
            return 0
        if cov_pri[v] < 2:
            return 0
        mn = maxc
        for u in adjacency[v]:
            cu = cov_pri[u]
            if cu < 2:
                return 0
            if cu < mn:
                mn = cu
        if mn == maxc:
            mn = cov_pri[v]
        return (((maxc - mn) * base + len(adjacency[v])) * base + v)

    pheap = []
    for v in answer:
        k = compute_key(v)
        if k:
            pheap.append(k)
    heapq.heapify(pheap)

    while pheap:
        k = heapq.heappop(pheap)
        v = k % base
        ck = compute_key(v)
        if ck == 0:
            continue
        if ck != k:
            heapq.heappush(pheap, ck)
            continue

        sel_pri[v] = 0
        cov_pri[v] -= 1
        for u in adjacency[v]:
            cov_pri[u] -= 1
        count_pri -= 1

    if count_pri < count_asc:
        return sel_pri
    return sel_asc


def unique_adjacency(adjacency, n):
    result = [None] * (n + 1)
    for v in range(1, n + 1):
        lst = adjacency[v]
        if len(lst) <= 1:
            result[v] = list(lst)
        else:
            result[v] = sorted(set(lst))
    return result


def dominates(adjacency, n, chosen):
    covered = bytearray(n + 1)
    for v in chosen:
        covered[v] = 1
        for u in adjacency[v]:
            covered[u] = 1
    for v in range(1, n + 1):
        if not covered[v]:
            return False
    return True


def reduced_candidate(adjacency, nbr, n, max_deg):
    mandatory = bytearray(n + 1)

    for v in range(1, n + 1):
        d = len(nbr[v])
        if d == 0:
            mandatory[v] = 1
        elif d == 1:
            u = nbr[v][0]
            if len(nbr[u]) == 1:
                if v < u:
                    mandatory[v] = 1
            else:
                mandatory[u] = 1

    dominated_by_m = bytearray(n + 1)
    for v in range(1, n + 1):
        if mandatory[v]:
            dominated_by_m[v] = 1
            for u in nbr[v]:
                dominated_by_m[u] = 1

    residual = []
    for v in range(1, n + 1):
        if not dominated_by_m[v]:
            residual.append(v)

    if not residual:
        return [v for v in range(1, n + 1) if mandatory[v]]

    res_adj = [None] * (n + 1)
    for v in residual:
        res_adj[v] = [u for u in nbr[v] if not dominated_by_m[u]]

    rep_of = [0] * (n + 1)
    sig_to_rep = {}
    reps = []

    for v in residual:
        seq = res_adj[v] + [v]
        seq.sort()
        h1 = len(seq)
        h2 = len(seq)
        total = 0
        total2 = 0
        for x in seq:
            total += x
            total2 += x * x
            h1 = (h1 * 1000003 + x) % 1000000007
            h2 = (h2 * 1000003 + x) % 1000000009
        sig = (len(seq), total, total2, h1, h2)
        r = sig_to_rep.get(sig)
        if r is None:
            sig_to_rep[sig] = v
            rep_of[v] = v
            reps.append(v)
        else:
            rep_of[v] = r

    k = len(reps)
    if k == 0:
        return None

    q_index = {}
    for i, r in enumerate(reps, 1):
        q_index[r] = i

    q_adj = [array('I') for _ in range(k + 1)]
    for i, r in enumerate(reps, 1):
        seen = set()
        for u in res_adj[r]:
            ru = rep_of[u]
            if ru == 0:
                return None
            if ru != r:
                seen.add(ru)
        for ru in seen:
            qi = q_index.get(ru)
            if qi is None:
                return None
            q_adj[i].append(qi)

    q_selected, q_answer, q_max_deg = greedy_select(q_adj, k)

    cand_sel = bytearray(n + 1)
    for v in range(1, n + 1):
        if mandatory[v]:
            cand_sel[v] = 1

    for i, r in enumerate(reps, 1):
        if q_selected[i]:
            cand_sel[r] = 1

    cand_answer = [v for v in range(1, n + 1) if cand_sel[v]]
    if not cand_answer:
        return None

    cand_final = prune_solution(nbr, n, cand_sel, cand_answer, max_deg)
    result = [v for v in range(1, n + 1) if cand_final[v]]

    if not dominates(adjacency, n, result):
        return None
    return result


def main():
    stream = sys.stdin.buffer
    n = 0
    for line in stream:
        parts = line.split()
        if not parts:
            continue
        if parts[0] == b'p':
            if len(parts) >= 3 and parts[1] in (b'edge', b'col', b'ds'):
                n = int(parts[2])
            elif len(parts) >= 2:
                n = int(parts[1])
            break

    adjacency = [array('I') for _ in range(n + 1)]
    for line in stream:
        parts = line.split()
        if not parts:
            continue
        first = parts[0]
        if first.startswith(b'c') or first.startswith(b'#'):
            continue
        if first in (b'e', b'a'):
            if len(parts) < 3:
                continue
            u = int(parts[1])
            v = int(parts[2])
        else:
            if len(parts) < 2:
                continue
            u = int(parts[0])
            v = int(parts[1])
        if u == v:
            continue
        adjacency[u].append(v)
        adjacency[v].append(u)

    if n == 0:
        sys.stdout.write('0' + chr(10))
        return

    selected, answer, max_deg = greedy_select(adjacency, n)
    base_sel = prune_solution(adjacency, n, selected, answer, max_deg)
    baseline = [v for v in range(1, n + 1) if base_sel[v]]

    nbr = unique_adjacency(adjacency, n)
    nbr_max_deg = 0
    for v in range(1, n + 1):
        d = len(nbr[v])
        if d > nbr_max_deg:
            nbr_max_deg = d

    candidate = reduced_candidate(adjacency, nbr, n, nbr_max_deg)

    if candidate is None:
        result = baseline
    elif len(candidate) < len(baseline):
        result = candidate
    elif len(candidate) > len(baseline):
        result = baseline
    else:
        if candidate < baseline:
            result = candidate
        else:
            result = baseline

    nl = chr(10)
    out = [str(len(result))]
    for v in result:
        out.append(str(v))
    sys.stdout.write(nl.join(out) + nl)


if __name__ == '__main__':
    main()
