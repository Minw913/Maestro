diff --git a/src/ale_bench/utils.py b/src/ale_bench/utils.py
index eb2a282..6a4f0c9 100644
--- a/src/ale_bench/utils.py
+++ b/src/ale_bench/utils.py
@@ -1,6 +1,7 @@
 """General utility helpers for filesystem, docker, and parsing."""
 
 import base64
+import functools
 import io
 import logging
 import os
@@ -38,6 +39,23 @@ def docker_client() -> Generator[docker.DockerClient, None, None]:
         client.close()
 
 
+@functools.cache
+def _rootless_docker() -> bool:
+    with docker_client() as client:
+        return any("rootless" in option for option in client.info().get("SecurityOptions", []))
+
+
+def container_uid() -> int:
+    """Host uid to run judge containers as; 0 under rootless Docker, where container root maps to the invoking user."""
+    return 0 if _rootless_docker() else os.getuid()
+
+
+def container_gid() -> int:
+    """Host gid counterpart of `container_uid`."""
+    return 0 if _rootless_docker() else os.getgid()
+
+
+
 # Cache
 def get_cache_dir() -> Path:
     """Get the cache directory for ALE-Bench.
