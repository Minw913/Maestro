# Operator settings, read by `python -m maestro` and pytest. Shell variables win.

# Opt-in live wire tests (tests/contract/test_codex_native_wire.py, test_deepseek_runtime.py)
# MAESTRO_RUN_NATIVE_WIRE=1
# MAESTRO_CODEX_EXECUTABLE=/path/to/codex
# MAESTRO_DSH_EXECUTABLE=

# Coral source if not vendor/coral
# MAESTRO_CORAL_SOURCE=

# Credential named by configs/runtimes/coral_deepseek.yaml (deepseek_api_key_env)
# DEEPSEEK_API_KEY=
